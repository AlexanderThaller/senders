# Lint and format configuration, set unconditionally rather than behind a
# --config.
#
# This is the point of the arrangement. If clippy and rustfmt lived under their
# own --config, checking them would mean a separate bazel invocation, and every
# flip of a build setting discards Bazel's analysis cache -- so each run would
# re-analyse the whole graph to re-check work the previous one had already
# done. A build setting that never changes never invalidates anything, so
# clippy and rustfmt are ordinary targets (see rust_clippy / rustfmt_test in
# the BUILD files) covered by the same `bazel test //...` as everything else.
build --@rules_rust//rust/settings:clippy_flag=-Dwarnings

# The same .clippy.toml cargo reads, so `allow-unwrap-in-tests` and
# `allow-dbg-in-tests` mean the same thing in both builds.
#
# The lint list itself is NOT restated here. crate.from_cargo's
# generate_lint_config reads [workspace.lints.rust] and [workspace.lints.clippy]
# out of Cargo.toml and lint_config() feeds them to each target, so there is no
# second copy to drift. To see what clippy is actually handed:
#   bazel aquery 'mnemonic("Clippy", //crates/server:senders_server)' --output=text
build --@rules_rust//rust/settings:clippy.toml=//:.clippy.toml

# There is deliberately no rustfmt.toml label_flag: this repo has no such file,
# so both builds format with stock rustfmt and cannot disagree.

# Cargo profile equivalents.
#
# Bazel has no notion of a named Cargo profile -- it has -c fastbuild/dbg/opt --
# so [profile.deploy] in Cargo.toml is reproduced here as a --config shorthand.
# Keep the two in step.
#
# `extra_rustc_flag` (singular) is the repeatable form and accumulates; the
# plural `extra_rustc_flags` would clobber on each use.
#
# Name the binary, not `//...`: rustc requires one panic strategy across the
# whole crate graph and libtest needs unwind, so the test targets cannot build
# under this. `cargo test --profile deploy` fails for the same reason. Use
#   bazel build --config=deploy //crates/server:senders
build:deploy --compilation_mode=opt
build:deploy --@rules_rust//rust/settings:lto=fat
build:deploy --@rules_rust//rust/settings:codegen_units=1
build:deploy --@rules_rust//rust/settings:extra_rustc_flag=-Cpanic=abort
# [profile.deploy] sets strip = "none"; -c opt would otherwise strip at link.
build:deploy --@rules_rust//rust/settings:extra_rustc_flag=-Cstrip=none
build:deploy --strip=never

# The .cargo/config.toml equivalent. Kept separate from the profile, as it is
# there: combine as needed, --config=deploy --config=x86-64-v3
build:x86-64-v3 --@rules_rust//rust/settings:extra_rustc_flag=-Ctarget-cpu=x86-64-v3

# The frontend is NOT part of the Bazel build. crates/web targets
# wasm32-unknown-unknown and needs wasm-bindgen, wasm-opt and asset hashing on
# top of rustc, which trunk already does; reproducing that here would duplicate
# a working pipeline for no gain. Run `trunk build --release` before serving.

build --verbose_failures
test --test_output=errors
