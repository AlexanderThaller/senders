# The Cargo manifests are the source of truth for dependencies, edition and
# lints; MODULE.bazel's crate.from_cargo reads them through these labels.
exports_files([
    "Cargo.toml",
    "Cargo.lock",
    # .bazelrc points the rules_rust clippy.toml label_flag at this.
    ".clippy.toml",
])

# The trunk-built frontend, packaged into the container image by //deploy:image.
#
# allow_empty is on, and has to be: a glob is evaluated when the package is
# LOADED, so `allow_empty = False` fails every `bazel …  //...` on a tree where
# trunk has not run — including `bazel test //...`, which has no interest in the
# frontend at all. The "did you forget to build it" check therefore lives at
# build time instead, in //deploy:frontend_guard.
filegroup(
    name = "frontend",
    srcs = glob(
        ["dist/**"],
        allow_empty = True,
    ),
    visibility = ["//deploy:__pkg__"],
)
