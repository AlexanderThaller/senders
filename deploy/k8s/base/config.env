SENDERS_BIND=0.0.0.0:8080
SENDERS_LOG=info,tower_http=warn

# Placeholders. Every overlay must set these: with `memory:` metadata or `fs:`
# storage, a second replica cannot serve a link the first one accepted, so the
# two replicas in the base Deployment would hand out links that 404 about half
# the time.
SENDERS_METADATA=redis://REPLACE-ME:6379
SENDERS_STORAGE=s3://REPLACE-ME

# 2 GiB. The ingress body-size limit has to be at least this too.
SENDERS_MAX_FILE_SIZE=2147483648
SENDERS_DEFAULT_EXPIRY=86400
SENDERS_MAX_EXPIRY=2592000
SENDERS_MAX_DOWNLOADS=1000

# Every replica runs the expiry sweep. That is safe -- deletion is idempotent
# and the download budget is claimed with an atomic script -- but the interval
# is per replica, so N replicas sweep N times as often.
SENDERS_REAP_INTERVAL=60

SENDERS_AUTH_MODE=off
