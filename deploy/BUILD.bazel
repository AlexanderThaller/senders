load("@rules_oci//oci:defs.bzl", "oci_image", "oci_load", "oci_push")
load("@rules_pkg//pkg:mappings.bzl", "pkg_attributes", "pkg_files", "strip_prefix")
load("@rules_pkg//pkg:tar.bzl", "pkg_tar")

# The container image, on distroless.
#
# Two layers rather than one: the frontend changes on every UI edit while the
# binary does not, and vice versa, so keeping them apart means a rebuild pushes
# only the half that moved.
#
# Caveat worth knowing: rules_rs links against the host's C library, so the
# binary carries whatever glibc symbol versions the build machine's glibc
# provides (currently up to GLIBC_2.38). The base image is pinned to
# debian13/trixie, which has 2.41, so there is headroom -- but building on a
# much newer host can still produce a binary the base cannot load. A hermetic
# sysroot or a musl target would remove the coupling; neither is set up here.

pkg_files(
    name = "server_files",
    srcs = ["//crates/server:senders"],
    attributes = pkg_attributes(mode = "0755"),
    prefix = "/usr/local/bin",
)

pkg_tar(
    name = "server_layer",
    srcs = [":server_files"],
)

# From here down, everything depends on ./dist, which Bazel packages but does
# not build, so all of it is tagged `manual` and stays out of `//...`. That is
# what keeps `bazel test //...` working on a tree where trunk has never run.
# Build these by label: `bazel build //deploy:image`, or `just image`.

# Fails the build, with an actionable message, when ./dist is empty.
#
# The check has to happen here rather than as `allow_empty = False` on the glob:
# a glob is evaluated when its package is LOADED, so that version broke every
# `bazel … //...` instead of only the image build. This emits an empty tar
# merged into the frontend layer through pkg_tar's `deps`, so it adds no file
# and no layer -- the image digest is unchanged by its presence.
genrule(
    name = "frontend_guard",
    srcs = ["//:frontend"],
    outs = ["frontend_guard.tar"],
    cmd = """
if [ -z "$(SRCS)" ]; then
  echo "ERROR: ./dist is empty. Bazel packages the frontend but does not build" >&2
  echo "       it. Run 'trunk build --release' first, or use 'just image'." >&2
  exit 1
fi
tar -cf $@ -T /dev/null
""",
    tags = ["manual"],
)

pkg_files(
    name = "frontend_files",
    srcs = ["//:frontend"],
    prefix = "/srv/dist",
    strip_prefix = strip_prefix.from_root("dist"),
    tags = ["manual"],
)

pkg_tar(
    name = "frontend_layer",
    srcs = [":frontend_files"],
    tags = ["manual"],
    deps = [":frontend_guard"],
)

oci_image(
    name = "image",
    base = "@distroless_cc",
    entrypoint = ["/usr/local/bin/senders"],
    env = {
        "SENDERS_STATIC_DIR": "/srv/dist",
        "SENDERS_BIND": "0.0.0.0:8080",
        "SENDERS_LOG": "info,tower_http=warn",
    },
    exposed_ports = ["8080/tcp"],
    # `image.source` is what makes GHCR attach the package to this repository;
    # the rest is what `docker inspect` shows. These are static: a stamped
    # revision label would make every build non-deterministic for the sake of
    # information `git describe` already puts in the tag.
    labels = {
        "org.opencontainers.image.title": "senders",
        "org.opencontainers.image.description": "End-to-end encrypted file sharing",
        "org.opencontainers.image.source": "https://github.com/athaller/senders",
        "org.opencontainers.image.licenses": "MIT",
    },
    tags = ["manual"],
    tars = [
        ":server_layer",
        ":frontend_layer",
    ],
    # distroless ships this account; there is no shell to fall back to anyway.
    user = "nonroot",
    visibility = ["//visibility:public"],
)

# `bazel run //deploy:image_load` puts `senders:latest` into the local daemon,
# which is what docker-compose.yml expects to find.
oci_load(
    name = "image_load",
    image = ":image",
    repo_tags = ["senders:latest"],
    tags = ["manual"],
    visibility = ["//visibility:public"],
)

# `bazel run //deploy:image_push -- --tag <tag>` pushes to the registry.
#
# The repository here is the default; CI overrides it with
# `--repository ghcr.io/<owner>/<repo>` so a fork publishes to its own
# namespace rather than trying to write to this one. Tags are passed at run
# time for the same reason -- they depend on the ref being built.
#
# Push authenticates through the ambient docker credentials: `docker login
# ghcr.io` locally, or docker/login-action in CI. crane reads the same
# ~/.docker/config.json.
oci_push(
    name = "image_push",
    image = ":image",
    repository = "ghcr.io/athaller/senders",
    tags = ["manual"],
    visibility = ["//visibility:public"],
)
