"""senders -- end-to-end encrypted file sharing."""

module(
    name = "senders",
    version = "0.1.0",
)

bazel_dep(name = "rules_rs", version = "0.0.107")

toolchains = use_extension("@rules_rs//rs/toolchains:module_extension.bzl", "toolchains")
toolchains.toolchain(
    edition = "2024",
    version = "1.98.0",
)
use_repo(toolchains, "default_rust_toolchains")

register_toolchains("@default_rust_toolchains//...")

# Exposes rules_rs' patched rules_rust as @rules_rust, so the
# @rules_rust//rust/settings:* flags used in .bazelrc can be named from the
# command line.
rules_rust = use_extension("@rules_rs//rs:rules_rust.bzl", "rules_rust")
use_repo(rules_rust, "rules_rust")

# Dependencies, edition and lint configuration come from the Cargo manifests,
# so adding a crate needs no BUILD.bazel change. Cargo.lock stays the source of
# truth for versions; MODULE.bazel.lock records the resolved set.
#
# This reads the workspace root manifest, which covers crates/proto and
# crates/server. crates/web is a separate Cargo workspace built by trunk.
bazel_dep(name = "rules_oci", version = "2.3.0")
bazel_dep(name = "rules_pkg", version = "1.3.0")

# Pulled in transitively by rules_oci, but pinned forward: the version it would
# otherwise select registers a coreutils toolchain that still passes
# `incompatible_use_toolchain_transition` to rule(), which Bazel 9 removed.
bazel_dep(name = "aspect_bazel_lib", version = "2.22.5")

# The container base.
#
# `cc` rather than `base`: the server links libgcc_s (see //deploy:image), and
# `base` does not carry it. debian13 rather than debian12 because the binary is
# linked against the host's glibc and needs symbols up to GLIBC_2.38; trixie
# ships 2.41, bookworm only 2.36. See the note in //deploy/BUILD.bazel.
oci = use_extension("@rules_oci//oci:extensions.bzl", "oci")
oci.pull(
    name = "distroless_cc",
    digest = "sha256:9b615fff20e1a4fad29c2b30562580b212c7dd5e2225236735cca0070ed11c78",
    image = "gcr.io/distroless/cc-debian13",
    platforms = ["linux/amd64"],
)
use_repo(oci, "distroless_cc", "distroless_cc_linux_amd64")

# Build AWS-LC with Bazel instead of through aws-lc-sys' build script.
#
# rules_rs prints a warning recommending this, and it is worth taking: the
# build script drives cc-rs, which compiles a few thousand C files in the
# sandbox and bakes the sandbox path into the DWARF it emits. That path
# contains a generation counter that changes on every execution, so the outputs
# are not reproducible between machines -- or between two checkouts on one
# machine -- and a shared cache cannot be hit. Under Bazel's own cc rules the
# same sources become ordinary cached actions.
#
# `rustc_flags` and the additive BUILD file come from
# @rules_rs//3rd_party/aws-lc-sys:include.MODULE.bazel verbatim; only the hub
# repository in `deps` is ours (the snippet writes it as a placeholder).
bazel_dep(name = "aws-lc", version = "5.1.0.bcr.2")

rules_rust_bindgen = use_extension("@rules_rs//rs:rules_rust_bindgen.bzl", "rules_rust_bindgen")
use_repo(rules_rust_bindgen, "rules_rust_bindgen")

register_toolchains("@rules_rust_bindgen//:all")

crate = use_extension("@rules_rs//rs:extensions.bzl", "crate")
crate.annotation(
    crate = "aws-lc-rs",
    gen_build_script = "off",
)
crate.annotation(
    additive_build_file = "@rules_rs//3rd_party/aws-lc-sys:additive.BUILD.bazel",
    crate = "aws-lc-sys",
    extra_aliased_targets = {"aws_lc_sys_build_info": "aws_lc_sys_build_info"},
    gen_build_script = "off",
    rustc_flags = ["--cfg=use_bindgen_pregenerated"],
    deps = ["@crates//:aws_lc_sys_build_info"],
)

inject_repo(crate, "aws-lc")

crate.from_cargo(
    name = "crates",
    cargo_lock = "//:Cargo.lock",
    cargo_toml = "//:Cargo.toml",
    generate_lint_config = True,
    platform_triples = [
        "x86_64-unknown-linux-gnu",
    ],
)
use_repo(crate, "crates")
